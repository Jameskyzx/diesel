{
  "name": "global-diesel-regulations",
  "version": "0.1.0",
  "private": true,
  "description": "Global diesel-engine regulations, product-fit, market-data, and AI sales-analysis application.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "demo": "tsx scripts/demo/server.ts",
    "demo:fde": "tsx scripts/demo/fde-server.ts",
    "build": "node --import tsx scripts/next-build.ts",
    "start": "next start",
    "map:prepare-assets": "tsx scripts/maplibre-worker-assets.ts --write",
    "map:verify-assets": "tsx scripts/maplibre-worker-assets.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:app": "vitest run --coverage --exclude tests/deploy-scripts.test.ts --exclude tests/host-activation-ledger.test.ts --exclude tests/release-publication-controller.test.ts --exclude tests/host-release-orchestrator.test.ts",
    "test:deploy:contracts": "vitest run tests/deploy-scripts.test.ts tests/host-activation-ledger.test.ts tests/release-publication-controller.test.ts tests/host-release-orchestrator.test.ts --reporter=verbose --slowTestThreshold=0",
    "test:watch": "vitest",
    "ai:eval": "vitest run tests/sales-chat-harness.test.ts --reporter=verbose",
    "ai:eval:live": "node scripts/ai/live-eval-bootstrap.mjs",
    "portfolio:verify": "node --conditions=react-server --import tsx scripts/portfolio/verify.ts",
    "portfolio:capture-vitest-evidence": "node --import tsx scripts/portfolio/capture-vitest-execution-evidence.ts",
    "portfolio:capture-playwright-evidence": "node --import tsx scripts/portfolio/capture-playwright-evidence.ts",
    "portfolio:capture-screenshots": "tsx scripts/portfolio/capture-screenshots.ts",
    "portfolio:verify-playwright-runs": "node --import tsx scripts/portfolio/verify-playwright-runs.ts",
    "test:e2e": "playwright test",
    "test:e2e:csp:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "test:e2e:fde": "playwright test --config playwright.fde.config.ts",
    "playwright": "playwright",
    "audit:actions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/security/check-github-action-pins.ts",
    "audit:security": "tsx scripts/security/check-pnpm-audit.ts",
    "history:verify": "node --import tsx scripts/history/verify-development-history.ts",
    "release:authorize:bundle": "env -u ESBUILD_BINARY_PATH -u NODE_OPTIONS node scripts/deploy/build-release-authorization.mjs",
    "release:authorize": "env -u NODE_OPTIONS node scripts/deploy/verify-release-authorization.bundle.mjs",
    "db:check": "drizzle-kit check",
    "db:smoke:postgres": "tsx scripts/db/postgres-smoke.ts",
    "db:smoke:country-detail-consistency": "node --conditions=react-server --import tsx scripts/db/postgres-country-detail-consistency-smoke.ts",
    "db:smoke:governance-concurrency": "node --conditions=react-server --import tsx scripts/db/postgres-governance-concurrency-smoke.ts",
    "db:smoke:rate-limit-concurrency": "node --conditions=react-server --import tsx scripts/db/postgres-rate-limit-concurrency-smoke.ts",
    "db:smoke:upgrade": "tsx scripts/db/postgres-upgrade-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/db/migrate.ts",
    "db:archive-invalid-products": "node --conditions=react-server --import tsx --env-file=.env.local scripts/db/archive-invalid-unpublished-products.ts",
    "db:backup": "node --conditions=react-server --import tsx --env-file=.env.local scripts/db/backup-postgres.ts",
    "db:verify-production": "node --conditions=react-server --import tsx scripts/db/verify-production-readback.ts",
    "db:seed": "tsx --env-file=.env.local scripts/db/seed.ts",
    "knowledge:orphans": "tsx --env-file=.env.local scripts/db/scan-orphaned-knowledge-files.ts",
    "knowledge:orphans:delete": "tsx --env-file=.env.local scripts/db/with-governance-maintenance-lock.ts -- pnpm exec tsx --env-file=.env.local scripts/db/scan-orphaned-knowledge-files.ts --delete",
    "ops:canary": "tsx scripts/ops/synthetic-canary.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.16",
    "@ai-sdk/react": "^4.0.43",
    "ai": "^7.0.40",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.27.0",
    "maplibre-gl": "6.9.0",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "unpdf": "^1.8.0",
    "vaul": "1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-pgvector": "^0.0.5",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
