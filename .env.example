# Non-sensitive application metadata.
APP_VERSION=local

# Server-only PostgreSQL connection string. Replace with the Supabase pooler or
# direct connection string for the target environment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Production and normal local development use postgres. pglite-demo is reserved
# for deterministic browser tests and never represents production data.
DATABASE_MODE=postgres

# Server-only storage root for the developer knowledge-base importer.
# This local filesystem adapter is for development only; production must point
# to durable private storage or replace the adapter with Supabase Storage.
KNOWLEDGE_STORAGE_ROOT=knowledge

# Server-only AI provider configuration. Keep the real API key in .env.local
# or the deployment secret manager; never commit it to GitHub. AI_BASE_URL
# accepts only an HTTPS origin/path without credentials, query, or fragment;
# authentication belongs only in AI_API_KEY.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=your-model-name
# Optional but required for image uploads. It must accept image input and
# Function Calling on the same OpenAI-compatible endpoint (for example,
# qwen3.7-plus on Alibaba Cloud Model Studio).
AI_MULTIMODAL_MODEL=your-vision-model-name
AI_API_KEY=replace-with-server-side-secret
AI_ENABLE_THINKING=false
# Optional compatibility opt-in. When true, streaming requests ask the provider
# to return token usage. It does not enable prompt caching, and unsupported
# OpenAI-compatible providers may reject the request.
AI_INCLUDE_USAGE=false
# Optional strict JSON pricing snapshot for runtime-only estimated cost logs.
# It must exactly match the emitted provider/model ID and include ISO `asOf`
# plus inclusive ISO `validThrough` dates (`validThrough >= asOf`). Profiles
# without an explicit validity end fail closed. Keep private rates only in the
# deployment secret manager; do not commit them or live-eval reports.
AI_COST_PROFILE_JSON=

# Server-only fixed-window limits for POST /api/chat. The global limit is a
# compatibility-defaulted safety ceiling (10,000 when omitted); public
# deployments should select an explicit lower capacity. The per-client limit
# must not exceed the global limit. Production always requires the shared
# postgres backend; memory is only for single-process development and tests.
AI_CHAT_RATE_LIMIT_GLOBAL_PER_HOUR=300
AI_CHAT_RATE_LIMIT_PER_HOUR=30
AI_CHAT_RATE_LIMIT_BACKEND=postgres
# Application-side daily admission budget for model-bound public chat. Version
# 1 reserves 5 estimated provider-call units per request (the route's maximum
# five provider steps). Production requires both values; they must be multiples
# of 5 and client <= global. These are not token, cost, or provider hard caps.
AI_CHAT_ADMISSION_GLOBAL_PROVIDER_CALL_UNITS_PER_DAY=50000
AI_CHAT_ADMISSION_CLIENT_PROVIDER_CALL_UNITS_PER_DAY=500

# Server-only opportunity-score-v1 weights. Values must each be between 0 and
# 1 and must sum to exactly 1. The model cannot provide or override them.
OPPORTUNITY_SCORE_MARKET_WEIGHT=0.5
OPPORTUNITY_SCORE_PRODUCT_WEIGHT=0.3
OPPORTUNITY_SCORE_REGULATORY_WEIGHT=0.2

# Verification freshness threshold in days (ADR-045). Countries verified
# longer ago than this show a stale warning in the UI (warning only; data
# is never hidden). Positive integer, max 3650, default 90.
COUNTRY_STALE_AFTER_DAYS=90

# Server-only workspace identity allowlist for /admin and /api/admin.
# The reverse proxy must strip user-supplied oai-authenticated-user-email and
# inject the authenticated workspace email. Roles: editor, reviewer, admin.
ADMIN_ROLE_BINDINGS_JSON={"editor@example.com":"editor","reviewer@example.com":"reviewer","admin@example.com":"admin"}
